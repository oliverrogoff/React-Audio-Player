{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",       // MUST be ESM
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "src/AudioPlayer.tsx",
    "src/index.ts",
    "src/global.d.ts",
    "src/AudioPlayer.module.css"
  ]
}
